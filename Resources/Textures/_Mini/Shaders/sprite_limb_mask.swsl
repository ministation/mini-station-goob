// Keep only the part of a garment that is drawn over a limb (a sleeve over an arm), so that piece can
// ride the limb's swing together with it instead of staying behind and letting bare skin show at the
// shoulder. The limb's own art is fed in as the mask by a CopyToShaderParameters layer
// (limbMap / limbUV), so no pixel readback is needed and it works for every species and facing.
uniform sampler2D limbMap;
uniform highp vec4 limbUV;

void fragment()
{
    highp vec4 limb = texture2D(limbMap, mix(limbUV.xy, limbUV.zw, UV2));
    COLOR = limb.a > 0.05 ? zTexture(UV) : vec4(0.0);
}
