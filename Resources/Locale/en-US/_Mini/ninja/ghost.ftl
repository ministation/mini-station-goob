# Ghost path of the ninja suit: modules, actions and popups.

ninja-module-ghost-smoke = Smoke screen
ninja-module-ghost-smoke-desc = Deploys a cloud of smoke to break the line of sight. Automatic mode adds a weakened cloud to a few other abilities and costs less energy.
ninja-module-ghost-cloak = Phase cloak
ninja-module-ghost-cloak-desc = Turns you invisible. The suit heats up while the cloak is active, and an overheated suit forces the cloak off.
ninja-module-ghost-clones = Holographic clones
ninja-module-ghost-clones-desc = Spawns several holographic copies of you and swaps your position with one of them. The copies live for five seconds, attack your enemies and split on attacks.
ninja-module-ghost-disguise = Chameleon
ninja-module-ghost-disguise-desc = Scans a crew member and copies their appearance, name and voice. The disguise is dropped on damage and drains suit power while it lasts.
ninja-module-ghost-spiritform = Spirit form
ninja-module-ghost-spiritform-desc = Turns your body into a ghost that passes through walls. Costs a large part of the suit charge on activation and every second, and turns off when the charge runs out.

ent-ActionNinjaGhostSmoke = Smoke screen
    .desc = Deploy a cloud of smoke that hides you from sight.
ent-ActionNinjaGhostSmokeAuto = Automatic smoke
    .desc = Deploy a weakened cloud of smoke automatically when using some other abilities.
ent-ActionNinjaGhostCloak = Phase cloak
    .desc = Turn invisible. The suit heats up while the cloak is active.
ent-ActionNinjaGhostClones = Holographic clones
    .desc = Create several holographic copies of yourself and swap places with one of them.
ent-ActionNinjaGhostDisguiseScan = Appearance scanner
    .desc = Scan a nearby crew member and save their appearance.
ent-ActionNinjaGhostDisguiseMenu = Chameleon
    .desc = Apply the last scanned appearance, or reset the current disguise.
ent-ActionNinjaGhostSpiritForm = Spirit form
    .desc = Become a ghost that can pass through walls.

ninja-ghost-cloak-heat-warning = The suit is heating up.
ninja-ghost-cloak-heat-danger = The suit is dangerously hot!
ninja-ghost-cloak-overheated = The suit overheated, the cloak turned off.

ninja-ghost-disguise-scan-success = Appearance of {$name} saved.
ninja-ghost-disguise-scan-fail-not-humanoid = The scanner can not read this target.
ninja-ghost-disguise-scan-fail-out-of-range = The target is too far away.
ninja-ghost-disguise-scan-fail-energy = Not enough suit charge.
ninja-ghost-disguise-no-entries = No scanned appearances yet.
ninja-ghost-disguise-applied = Disguise applied: {$name}.
ninja-ghost-disguise-reset = Disguise reset.

ninja-ghost-spiritform-on = Spirit form activated.
ninja-ghost-spiritform-off = Spirit form deactivated.
ninja-ghost-spiritform-pushed = The suit pushed you out of the wall.
