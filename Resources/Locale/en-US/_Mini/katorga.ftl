katorga-greeting = You have been sent to the katorga for breaking the rules. Mine ore and deliver it to the ore receiver to reduce your sentence. Time remaining: { $time }.

katorga-time-reduced = Your sentence has been reduced by { $time }.

katorga-penalty-message = Killing a fellow inmate has extended your sentence by { $time }.

katorga-penalty-admin = Katorga: player { $user } killed a fellow inmate, sentence extended by { $time }.

katorga-map-missing = The katorga map is unavailable, connection is not possible. Contact the administration.

katorga-ban-check-failed = Could not check your bans, connection cancelled. Please reconnect later.

katorga-hud-title = KATORGA

katorga-hud-remaining = Remaining: { $time }

katorga-hud-worked = Worked off: { $time }

katorga-hud-free = You are free!

katorga-released = Sentence served. You are free: you can ghost and observe, and next round you will join as a regular player.

katorga-ghost-blocked = No leaving the katorga early: serve your sentence or reconnect to get a new body on the katorga.

katorga-ghost-roles-blocked = Katorga inmates cannot take ghost roles.

katorga-ban-lobby = Ban time left: { $time }

katorga-ban-lobby-tooltip = Character customization is unavailable while your ban is active. Work it off at the katorga.

katorga-ban-latejoin = Your ban time left: { $time }
