ent-FishingSpotCapsule = fishing spot capsule
    .desc = An illegally modified mining capsule containing a small fishing spot connected to some faraway place.
ent-FishingSpotCapsuleHacked = fishing spot capsule
    .desc = An illegally modified mining capsule containing a small fishing spot connected to some faraway place.
    .suffix = emagged

fishing-spot-capsule-change = Change fishing spot
fishing-spot-capsule-selected = You change the capsule's selected fishing spot to {$spot}.
fishing-spot-capsule-safeties = Safeties disabled
fishing-spot-capsule-bad-area = The capsule refuses to deploy here. It needs a free open tile!
fishing-spot-capsule-deployed = The capsule deploys: {$spot}!

fishing-spot-capsule-option-river = Freshwater Spring
fishing-spot-capsule-option-river-desc = A spring from which you can fish several freshwater fish, including goldfish, catfish and pikes.
fishing-spot-capsule-option-seawater = Saltwater Spring
fishing-spot-capsule-option-seawater-desc = A spring from which you can fish several saltwater fish, including clownfish, pufferfish and stingrays.
fishing-spot-capsule-option-tizira = Tiziran Spring
fishing-spot-capsule-option-tizira-desc = A spring from which you can fish several fish native to the lizardfolk's native planet, Tizira.
fishing-spot-capsule-option-hot-spring = Hot Spring
fishing-spot-capsule-option-hot-spring-desc = A hot spring. Its purposes as a fishing spot is limited, but at least you get to have a relaxing bath.
fishing-spot-capsule-option-ice = Ice Fishing Spot
fishing-spot-capsule-option-ice-desc = A small, already dug ice hole surrounded by snow. You can catch salmon and arctic char here.
fishing-spot-capsule-option-lava = Lava Fishing Spot
fishing-spot-capsule-option-lava-desc = A small puddle of not-safe-for-live lava. You can catch lava loops here, and maybe a chest.
fishing-spot-capsule-option-plasma = Plasma Fishing Spot
fishing-spot-capsule-option-plasma-desc = A small puddle of not-safe-for-live plasma. You can catch lava loops and arctic chrabs here.
fishing-spot-capsule-option-depths = Deep Ocean Fishing Spot
fishing-spot-capsule-option-depths-desc = A pool of deep water. You can catch ocean fish here.
