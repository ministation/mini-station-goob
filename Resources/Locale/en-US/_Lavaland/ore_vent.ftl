ent-LavalandOreVent = ore vent
    .desc = An ore vent, brimming with underground ore. Scan it with a mining scanner to start extracting ore from it.
ent-LavalandOreVentSpawner = ore vent spawner
    .desc = { ent-MarkerBase.desc }
ent-LavalandOreBoulder = boulder
    .desc = A chunk of rock torn out of an ore vent. Swing a pickaxe or a crusher at it to get at the ore inside.
ent-LavalandOreBoulderRock = boulder
    .desc = { ent-LavalandOreBoulder.desc }
ent-LavalandOreBoulderStone = boulder
    .desc = { ent-LavalandOreBoulder.desc }
ent-LavalandOreBoulderArtifact = artifact boulder
    .desc = A chunk of rock torn out of an ore vent, humming faintly. Swing a pickaxe or a crusher at it to get at what is inside.
ent-LavalandNodeDrone = NODE drone
    .desc = Standard in-atmosphere drone, used by Nanotrasen to operate and excavate valuable ore vents. Protect it while it works.
ent-LavalandOreVentStarter = active ore vent
    .desc = An ore vent, brimming with underground ore. This one is already supplying the outpost with iron and glass.

ore-vent-scanning = You start scanning the ore vent.
ore-vent-discovered = You have discovered an ore vent. It now has a GPS signal.
ore-vent-examine-undiscovered = This vent can be scanned with a mining scanner.
ore-vent-examine-discovered = This vent produces {$size} boulders containing {$minerals}.
ore-vent-gps-signal = ore vent
ore-vent-size-small = small
ore-vent-size-medium = medium
ore-vent-size-large = large
ore-vent-mineral-OreSteel = iron
ore-vent-mineral-OreSpaceQuartz = glass
ore-vent-mineral-OreCoal = coal
ore-vent-mineral-OreGold = gold
ore-vent-mineral-OreSilver = silver
ore-vent-mineral-OrePlasma = plasma
ore-vent-mineral-OreUranium = uranium
ore-vent-mineral-OreBananium = bananium
ore-vent-mineral-OreDiamond = diamond
ore-vent-defense-started = The ore vent rumbles. A NODE drone latches onto it, and something stirs below!
ore-vent-wave = Another wave of lavaland beasts bursts out of the ground!
ore-vent-tapped = The ore vent is secured. Boulders start rising to the surface.
ore-vent-failed = The NODE drone is destroyed, and the ore vent closes up again.
ore-vent-depleted = The ore vent runs dry, leaving something valuable behind.
ore-vent-already-tapped = This ore vent has already been tapped.
ore-vent-defending = The ore vent is already under attack. Protect the NODE drone!
ore-vent-recovering = The ore vent is still recovering from a failed excavation.
ore-vent-cannot-tap = The ore vent cannot be tapped right now.
ore-vent-boulder-tool = You need a pickaxe or a crusher to break this boulder.
ore-vent-boulder-hit = You break off a chunk of the boulder.
ore-vent-boulder-broken = The boulder crumbles, revealing what was inside.
