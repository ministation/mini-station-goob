reagent-name-tinlux = tinea luxor
reagent-desc-tinlux = A stimulating ichor which causes luminescent fungi to grow on the skin.

reagent-name-berserker = berserker toxin
reagent-desc-berserker = A psychoactive substance irritating the neural sectors responsible for fight or flight response, damaging them in the process.

reagent-name-liquid-gibs = liquid gibs
