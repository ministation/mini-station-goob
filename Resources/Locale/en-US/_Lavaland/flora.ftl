# Ash flora (TG ash_flora.dm)

ent-FloraAshFireBlossom = fire blossom
    .desc = An odd flower that grows commonly near bodies of lava.
ent-FloraAshGlowgrowth = glowgrowth colony
    .desc = A colony of bioluminescent fungi growing on a hot air vent.
ent-FloraAshInozhakust = inozhakust
    .desc = A plant that looks like roots growing into the sky.
ent-FloraAshPlasmaFlower = plasma flower
    .desc = Vines surrounding a clustered bunch of plasma flowers.
ent-FloraAshPodsneyzka = podsneyzka flower
    .desc = A bunch of flowering podsneyzkas whose roots hunt for decomposing corpses.
ent-FloraAshVahrezjia = vahrezjia flowers
    .desc = Bright blue stalks emerging from purple flowery pods.
ent-FloraAshDrakeBeet = drake beet
    .desc = A mutated beet that vaguely mimics the appearance of a drake.
ent-FloraAshStarCacti = star cacti
    .desc = A spikey, round cluster of prickly star cacti.
ent-FloraAshLargeMushrooms = large mushrooms
    .desc = A number of large mushrooms, covered in a faint layer of ash and spores.
ent-FloraAshLeafyMushrooms = leafy mushrooms
    .desc = A number of mushrooms, each surrounding a greenish sporangium.
ent-FloraAshTallMushrooms = tall mushrooms
    .desc = Several mushrooms with a ring of conks at the midpoint of their stems.
ent-FloraAshNumerousMushrooms = numerous mushrooms
    .desc = A large number of mushrooms, some with long fleshy stems. They radiate light.

ent-FoodAshFireBlossom = fire blossom
    .desc = A flower from a fire blossom.
ent-FoodAshGlowgrowthSheet = glowgrowth sheet
    .desc = A thick sheet of glowing fungi.
ent-FoodAshInozhakustMash = inozhakust mash
    .desc = The mashed up vines of an inozhakust.
ent-FoodAshPlasmaFlower = plasma flower
    .desc = A bit of vine connected to a crystallized plasma flower.
ent-FoodAshPodsneyzkaBunch = podsneyzka bunch
    .desc = A bunch of spotted podsneyzka flowers. They smell a bit like rotten meat.
ent-FoodAshVahrezjiaStalks = vahrezjia stalks
    .desc = Bunched together vahrezjia stalks. Surprisingly coarse in texture.
ent-FoodAshDrakeBeet = drake beet
    .desc = A mutated beet. Probably still tasty.
ent-FoodAshStarCactus = star cacti
    .desc = A spikey, round cluster of prickly star cacti.
ent-FoodAshMushroomShavings = mushroom shavings
    .desc = Some shavings from a large mushroom. With enough, might serve as a bowl.
ent-FoodAshMushroomLeaf = mushroom leaf
    .desc = A leaf, from a mushroom.
ent-FoodAshMushroomCap = mushroom cap
    .desc = The cap of a large mushroom.
ent-FoodAshMushroomStem = mushroom stem
    .desc = A long mushroom stem. It is slightly glowing.
ent-LavalandMushroomBowl = mushroom bowl
    .desc = A bowl made out of mushrooms. Not food, though it might have contained some at some point.

# Seed packs and mycelium

ent-LavalandCactusSeeds = packet of fruiting cactus seeds
    .desc = These seeds grow into fruiting cacti.
ent-LavalandStarCactusSeeds = packet of star cacti seeds
    .desc = These seeds grow into star cacti.
ent-LavalandPolyporeMycelium = polypore mycelium pack
    .desc = This mycelium grows into bracket mushrooms, also known as polypores.
ent-LavalandPorciniMycelium = porcini mycelium pack
    .desc = This mycelium grows into porcini mushrooms.
ent-LavalandInocybeMycelium = inocybe mycelium pack
    .desc = This mycelium grows into inocybe mushrooms.
ent-LavalandEmberMycelium = embershroom mycelium pack
    .desc = This mycelium grows into bioluminescent embershrooms.
ent-LavalandSerakaMycelium = seraka mycelium pack
    .desc = This mycelium grows into seraka mushrooms.
ent-LavalandFireBlossomSeeds = packet of fire blossom seeds
    .desc = These seeds grow into fire blossoms.
ent-LavalandGlowgrowthMycelium = glowgrowth mycelium pack
    .desc = This mycelium grows into glowgrowth fungi.
ent-LavalandVahrezjiaSeeds = packet of vahrezjia seeds
    .desc = These seeds grow into vahrezjia.
ent-LavalandPodsneyzkaSeeds = packet of podsneyzka seeds
    .desc = These seeds grow into podsneyzkas.
ent-LavalandInozhakustSeeds = packet of inozhakust seeds
    .desc = These seeds grow into an inozhakust.
ent-LavalandPlasmaFlowerSeeds = packet of plasma flower seeds
    .desc = These seeds grow into plasma flowers.
ent-LavalandSeedCache = lavaland seed cache
    .desc = A sealed cache of seeds from the ash wastes, kept by the seed vault keepers.

construction-graph-tag-fungus = fungus

