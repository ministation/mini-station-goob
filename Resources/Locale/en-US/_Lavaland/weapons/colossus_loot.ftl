ent-LavalandColossusArenaSpawner = colossus arena spawner
    .desc = { ent-MarkerBase.desc }
ent-LavalandCrateColossus = colossus chest
    .desc = A pristine chest guarded by the ancient arms dealer.
ent-LavalandBlasterTubes = blaster tubes
    .desc = Trophy tubes taken from a colossus.
ent-LavalandCainDagger = Cain
    .desc = The elder twin. It hungers for its brother's company.
ent-LavalandAbelDagger = Abel
    .desc = The younger twin. It hungers for its brother's blood.
ent-LavalandVocalCords = divine vocal cords
    .desc = The vocal cords of a god. Holding them to your throat lets you speak with authority.
