    .desc = { ent-MarkerBase.desc }
ent-LavalandCrateDragon = dragon chest
    .desc = A chest of the drake's hoard. It glows with inner heat.
ent-LavalandDrakeTailSpike = drake tail spike
    .desc = A trophy taken from the tail of an ash drake.
