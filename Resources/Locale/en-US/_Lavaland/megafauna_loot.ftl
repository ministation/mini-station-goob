# Megafauna loot: ash drake hide and the drake armour crafted from it.

ent-LavalandAshDrakeHide = ash drake hide
    .desc = Thick plates of hide torn from an ash drake. They still radiate heat.
ent-LavalandAshDrakeHide1 = { ent-LavalandAshDrakeHide }
    .desc = { ent-LavalandAshDrakeHide.desc }
ent-LavalandEquipmentDrakeArmour = drake armour
    .desc = A suit of armour crafted from the hide of an ash drake. It is warm to the touch and shrugs off flames.
ent-LavalandEquipmentDrakeHelm = drake helm
    .desc = The skull of an ash drake, worn as a helmet. Its empty sockets stare forward.

stack-ashdrake-hide = ash drake hide
