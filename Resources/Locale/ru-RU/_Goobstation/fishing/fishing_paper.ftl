ent-FishingTip = рыболовная подсказка
    .desc = Клочок бумаги с жемчужиной мудрости о рыбалке, хотя вам хотелось бы, чтобы это была настоящая жемчужина.
ent-LuresInstructions = инструкция к блеснам
    .desc = Серый листок с инструкцией для чайников по рыболовным блеснам. Пахнет дешёвкой.
ent-HazardWarningLava = табличка "осторожно, лава"
    .desc = Следите за лавой.
ent-HazardWarningPlasma = табличка "осторожно, плазма"
    .desc = Следите за плазмой.

fishing-tip-empty = Чернила расплылись в нечитаемое пятно.
fishing-tip-header = Рыболовная подсказка: { $fish }
