<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <packageSources>
  	<add key="nuget" value="https://api.nuget.org/v3/index.json" />
    <!--
      pkgs.dev.azure.com (и CDN *.vsblob.vsassets.io) режется DPI по SNI из этой сети,
      из-за чего restore падает с NU1301 (SSL connection could not be established).
      Пакет Microsoft.DotNet.RemoteExecutor выкачан вручную и лежит в локальном фиде.
      Оригинальный URL фида: https://pkgs.dev.azure.com/dnceng/public/_packaging/dotnet-eng/nuget/v3/index.json
    -->
    <add key="dotnet-eng" value="./local-nuget-feed" />
  </packageSources>
  <packageSourceMapping>
    <packageSource key="nuget">
      <package pattern="*" />
    </packageSource>
    <packageSource key="dotnet-eng">
      <package pattern="Microsoft.DotNet.RemoteExecutor" />
    </packageSource>
  </packageSourceMapping>
</configuration>
