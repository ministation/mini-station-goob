<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Client\</OutputPath>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- Mini: copy NuGet package DLLs (Concentus/NAudio) to bin/Content.Client —
         the packaging tool lists them from deps.json and reads them from this folder
         (same as Content.Server.csproj for Concentus). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <!-- Mini: голосовой чат клиента — отдельный опт-ин, а не DEVELOPMENT.
       Код войса держит сырые типы Lidgren/NAudio/Concentus, а клиентская песочница движка их
       запрещает ("Access to type not allowed"), поэтому сборка с войсом не проходит типчек и
       клиент падает на старте (Content.Goobstation.Client failed type checks). Разработка в
       DEVELOPMENT-логике означала, что падает вообще любой локальный клиент, — поэтому теперь
       войс включается флагом (и именно Rebuild: смена DefineConstants не инвалидирует
       инкрементальную сборку):
         dotnet build Content.Goobstation.Client -c Debug -p:MiniVoiceChat=True -t:Rebuild
       и такой клиент запускается только с отключённой песочницей:
         $env:ROBUST_DISABLE_SANDBOX=1
       Обычные сборки (без флага) войс не содержат и стартуют нормально. Подробнее:
       docs/_Mini/voice-chat-dev.md -->
  <PropertyGroup Condition="'$(MiniVoiceChat)' == 'True' And '$(FullRelease)' != 'True'">
    <DefineConstants>$(DefineConstants);VOICECHAT</DefineConstants>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <PackageReference Include="Nett" />
    <!-- Mini: аудио-библиотеки войса нужны только вместе с VOICECHAT, см. комментарий выше. -->
    <PackageReference Include="Concentus" Condition="'$(MiniVoiceChat)' == 'True' And '$(FullRelease)' != 'True'" />
    <PackageReference Include="NAudio" Condition="'$(MiniVoiceChat)' == 'True' And '$(FullRelease)' != 'True'" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Client.props" />
  <Import Project="..\RobustToolbox\Imports\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\Content.Client\Content.Client.csproj" />
    <ProjectReference Include="..\Content.Goobstation.Shared\Content.Goobstation.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\XamlIL.targets" />
</Project>
