<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>..\bin\Content.Client\</OutputPath>
    <OutputType Condition="'$(FullRelease)' != 'True'">Exe</OutputType>
    <WarningsAsErrors>nullable</WarningsAsErrors>
    <!-- Mini: copy NuGet package DLLs (Concentus/NAudio) to bin/Content.Client —
         the packaging tool lists them from deps.json and reads them from this folder
         (same as Content.Server.csproj for Concentus). -->
    <CopyLocalLockFileAssemblies>true</CopyLocalLockFileAssemblies>
  </PropertyGroup>
  <Import Project="../MSBuild/Content.props" />
  <ItemGroup>
    <PackageReference Include="Nett" />
    <!-- Mini: voice chat audio libs. Voice client code is DEVELOPMENT-only (see EntryPoint.cs):
         its raw Lidgren/NAudio/Concentus type references fail the wizden engine's client sandbox
         typecheck, so packaged FULL_RELEASE clients would crash on connect. -->
    <PackageReference Include="Concentus" Condition="'$(FullRelease)' != 'True'" />
    <PackageReference Include="NAudio" Condition="'$(FullRelease)' != 'True'" />
    <PackageReference Include="JetBrains.Annotations" PrivateAssets="All" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\Imports\Client.props" />
  <Import Project="..\RobustToolbox\Imports\Shared.props" />

  <ItemGroup>
    <ProjectReference Include="..\Content.Client\Content.Client.csproj" />
    <ProjectReference Include="..\Content.Goobstation.Shared\Content.Goobstation.Shared.csproj" />
  </ItemGroup>

  <Import Project="..\RobustToolbox\MSBuild\Robust.Properties.targets" />
  <Import Project="..\RobustToolbox\MSBuild\XamlIL.targets" />
</Project>
