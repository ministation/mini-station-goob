<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      xmlns:goob="clr-namespace:Content.Goobstation.Client.Research.UI"
                      Title="{Loc 'research-console-menu-title'}"
                      SetSize="1024 640"
                      MinSize="800 500">
    <BoxContainer Orientation="Vertical"
                  HorizontalExpand="True"
                  VerticalExpand="True"
                  Margin="8">
        <!-- Header -->
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="False"
                      SeparationOverride="12"
                      Margin="0 0 0 8">
            <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True">
                <RichTextLabel Name="ResearchAmountLabel"/>
                <RichTextLabel Name="ExperimentsLabel" Margin="0 4 0 0"/>
                <BoxContainer Name="TierDisplayContainer"
                              Orientation="Horizontal"
                              HorizontalExpand="True"
                              Margin="0 6 0 0"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical"
                          VerticalAlignment="Top"
                          HorizontalAlignment="Right"
                          MinWidth="160"
                          SeparationOverride="4">
                <Button Name="ServerButton"
                        Text="{Loc 'research-console-menu-server-selection-button'}"
                        MinHeight="36"
                        HorizontalExpand="True"/>
                <Button Name="JournalButton"
                        Text="{Loc 'research-console-menu-journal-button'}"
                        MinHeight="36"
                        HorizontalExpand="True"/>
                <Button Name="RecenterButton"
                        Text="{Loc 'research-console-menu-recenter-button'}"
                        MinHeight="36"
                        HorizontalExpand="True"
                        ToolTip="{Loc 'research-console-menu-recenter-button'}"/>
            </BoxContainer>
        </BoxContainer>

        <!-- Body: techweb + details -->
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      VerticalExpand="True"
                      SeparationOverride="8">
            <PanelContainer Name="ResearchesContainer"
                            VerticalExpand="True"
                            HorizontalExpand="True"
                            SizeFlagsStretchRatio="3">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#14181F" BorderThickness="1" BorderColor="#2A3340"/>
                </PanelContainer.PanelOverride>
                <goob:ResearchesContainerPanel
                    HorizontalExpand="True"
                    VerticalExpand="True"
                    Name="DragContainer"
                    MouseFilter="Pass"
                    RectClipContent="True"/>
            </PanelContainer>

            <PanelContainer SizeFlagsStretchRatio="1"
                            MinWidth="260"
                            MaxWidth="320"
                            VerticalExpand="True"
                            HorizontalExpand="True">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1A1F28" BorderThickness="1" BorderColor="#2A3340"/>
                </PanelContainer.PanelOverride>
                <BoxContainer Name="InfoContainer"
                              Orientation="Vertical"
                              VerticalExpand="True"
                              HorizontalExpand="True"
                              Margin="4"/>
            </PanelContainer>
        </BoxContainer>
    </BoxContainer>
</controls:FancyWindow>
