<Control xmlns="https://spacestation14.io"
         xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
         xmlns:customControls="clr-namespace:Content.Client.Administration.UI.CustomControls;assembly=Content.Client"
         xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
         HorizontalExpand="True"
         VerticalExpand="True"
         MinWidth="0">
    <BoxContainer Orientation="Vertical"
                  VerticalExpand="True"
                  HorizontalExpand="True"
                  SeparationOverride="6"
                  Margin="6">
        <!-- Header -->
        <BoxContainer Orientation="Horizontal"
                      HorizontalExpand="True"
                      SeparationOverride="8">
            <TextureRect Name="TechnologyTexture"
                         SetSize="48 48"
                         Stretch="KeepAspectCentered"
                         VerticalAlignment="Center"/>
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          VerticalAlignment="Center"
                          SeparationOverride="2">
                <Label Name="TechnologyNameLabel"
                       StyleClasses="LabelKeyText"
                       ClipText="True"
                       HorizontalExpand="True"/>
                <RichTextLabel Name="TechnologyCostLabel"
                               HorizontalExpand="True"
                               MaxWidth="280"/>
            </BoxContainer>
            <TextureRect Name="DisciplineTexture"
                         SetSize="28 28"
                         Stretch="KeepAspectCentered"
                         VerticalAlignment="Top"/>
        </BoxContainer>

        <Button Name="ResearchButton"
                Text="{Loc 'research-console-menu-server-research-button'}"
                HorizontalExpand="True"
                MinHeight="32"/>

        <customControls:HSeparator StyleClasses="LowDivider"/>

        <!-- Scrollable details -->
        <ScrollContainer HScrollEnabled="False"
                         VerticalExpand="True"
                         HorizontalExpand="True">
            <BoxContainer Orientation="Vertical"
                          HorizontalExpand="True"
                          SeparationOverride="8"
                          Margin="0 0 4 0">
                <RichTextLabel Name="NoPrereqLabel"
                               HorizontalAlignment="Center"
                               Text="{Loc 'research-console-no-tech-requirements'}"
                               Visible="True"/>

                <BoxContainer Name="PrereqsContainer"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="4"
                              Visible="False">
                    <Label Text="{Loc 'research-console-required-text'}"
                           HorizontalAlignment="Center"/>

                    <BoxContainer Name="RequiredExperimentsBlock"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  SeparationOverride="2"
                                  Margin="0 2 0 4">
                        <Label Text="{Loc 'research-console-tech-required-experiments-title'}"
                               Modulate="#DDA0DD"/>
                        <BoxContainer Name="RequiredExperimentsContainer"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="2"/>
                        <RichTextLabel Name="MissingExperimentsLabel" Visible="False"/>
                    </BoxContainer>

                    <BoxContainer Name="RequiredTechnologiesSection"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  Visible="False"
                                  SeparationOverride="2">
                        <Label Name="RequiredTechnologiesTitle"
                               Text="{Loc 'research-console-tech-required-technologies-title'}"
                               HorizontalAlignment="Center"/>
                        <BoxContainer Name="RequiredTechContainer"
                                      Orientation="Vertical"
                                      HorizontalExpand="True"
                                      SeparationOverride="4"/>
                    </BoxContainer>
                </BoxContainer>

                <BoxContainer Name="RecipesContainer"
                              Orientation="Vertical"
                              HorizontalExpand="True"
                              SeparationOverride="4">
                    <Label Text="{Loc 'research-console-unlocks-text'}"
                           HorizontalAlignment="Center"/>
                    <customControls:HSeparator StyleClasses="LowDivider"/>
                    <BoxContainer Name="UnlocksContainer"
                                  Orientation="Vertical"
                                  HorizontalExpand="True"
                                  SeparationOverride="3"/>
                    <controls:StripeBack Name="EmptyUnlocksStripe"
                                         Visible="False"
                                         Margin="0 4 0 0">
                        <Label Name="EmptyUnlocksLabel"
                               HorizontalExpand="True"
                               Align="Center"
                               Margin="4 2"/>
                    </controls:StripeBack>
                </BoxContainer>
            </BoxContainer>
        </ScrollContainer>
    </BoxContainer>
</Control>
