<PanelContainer xmlns="https://spacestation14.io"
                MinWidth="340"
                HorizontalAlignment="Center"
                MouseFilter="Ignore">
    <BoxContainer Orientation="Vertical" SeparationOverride="4" Margin="16 12" MouseFilter="Ignore">
        <TextureRect Name="Icon"
                     SetSize="64 64"
                     Stretch="KeepAspectCentered"
                     HorizontalAlignment="Center"
                     MouseFilter="Ignore" />
        <Label Name="NameLabel"
               StyleClasses="LabelHeading"
               Align="Center"
               HorizontalAlignment="Center"
               MouseFilter="Ignore" />
        <BoxContainer Name="DescriptionBox"
                      Orientation="Vertical"
                      HorizontalAlignment="Center"
                      MouseFilter="Ignore" />
        <PanelContainer Name="CoinPanel"
                        HorizontalAlignment="Center"
                        MouseFilter="Ignore"
                        Visible="False">
            <BoxContainer Name="CoinBox"
                          Orientation="Horizontal"
                          SeparationOverride="5"
                          Margin="9 3 11 3"
                          MouseFilter="Ignore">
                <TextureRect Name="CoinIcon"
                             SetSize="16 16"
                             Stretch="KeepAspectCentered"
                             VerticalAlignment="Center"
                             MouseFilter="Ignore" />
                <Label Name="CoinLabel"
                       VerticalAlignment="Center"
                       MouseFilter="Ignore" />
            </BoxContainer>
        </PanelContainer>
    </BoxContainer>
</PanelContainer>
