<ui:VoteCallMenu xmlns="https://spacestation14.io"
                 xmlns:ui="clr-namespace:Content.Client.Voting.UI"
                 xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                 Title="{Loc 'ui-vote-create-title'}"
                 MouseFilter="Stop"
                 MinSize="390 260"
                 Resizable="False">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" SeparationOverride="6">
        <Label Margin="8 4 8 0"
               Text="{Loc 'ui-vote-create-subtitle'}"
               StyleClasses="LabelSubText"
               HorizontalAlignment="Center" />
        <controls:HighDivider />

        <BoxContainer Orientation="Vertical"
                      Margin="10 4 10 0"
                      VerticalExpand="True"
                      VerticalAlignment="Top"
                      SeparationOverride="5">
            <Label Text="{Loc 'ui-vote-type-label'}" StyleClasses="LabelHeading" />
            <OptionButton Name="VoteTypeButton" HorizontalExpand="True" />
            <BoxContainer Name="VoteOptionsButtonContainer"
                          HorizontalExpand="True"
                          Orientation="Vertical"
                          SeparationOverride="4" />
            <Button Margin="48 2"
                    Name="FollowButton"
                    Text="{Loc 'ui-vote-follow-button'}"
                    Visible="False" />
            <Label Margin="2"
                   Name="VoteNotTrustedLabel"
                   Text="{Loc 'ui-vote-trusted-users-notice'}"
                   Visible="False" />
            <Label Margin="2"
                   Name="VoteWarningLabel"
                   Text="{Loc 'ui-vote-abuse-warning'}"
                   Visible="False"
                   HorizontalAlignment="Center" />
            <Label Margin="2"
                   Name="VoteTypeTimeoutLabel"
                   StyleClasses="LabelSubText"
                   Visible="False" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />
        <Button Margin="10 2 10 4"
                MinHeight="36"
                Name="CreateButton"
                StyleClasses="ButtonColorGreen"
                Text="{Loc 'ui-vote-create-button'}" />
        <Label Margin="12 0 0 2"
               StyleClasses="LabelSubText"
               Text="{Loc 'ui-vote-fluff'}" />
    </BoxContainer>
</ui:VoteCallMenu>
