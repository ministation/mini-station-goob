<DefaultWindow xmlns="https://spacestation14.io"
               xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
               Title="{Loc 'admin-player-actions-window-ert'}"
               MinSize="520 420"
               SetSize="560 480">
    <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6" HorizontalExpand="True" VerticalExpand="True">
        <BoxContainer Orientation="Horizontal">
            <PanelContainer SetWidth="6">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat BackgroundColor="#1d8bad" />
                </PanelContainer.PanelOverride>
            </PanelContainer>
            <Label Text="{Loc 'admin-player-actions-window-ert'}" StyleClasses="LabelHeading" Margin="6 0 0 0" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                <Label Text="{Loc 'ert-admin-cooldown-label'}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <LineEdit Name="CooldownSeconds" HorizontalExpand="True" />
                    <Button Name="SetCooldownButton" Text="{Loc 'ert-admin-apply-button'}" MinWidth="80" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                <Label Text="{Loc 'ert-admin-points-label'}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <LineEdit Name="PointsEdit" HorizontalExpand="True" />
                    <Button Name="SetPointsButton" Text="{Loc 'ert-admin-apply-button'}" MinWidth="80" />
                </BoxContainer>
            </BoxContainer>
            <Button Name="RefreshButton" Text="{Loc 'ert-admin-refresh-button'}" VerticalAlignment="Bottom" MinWidth="90" />
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" VerticalExpand="True">
                <Label Text="{Loc 'ert-admin-expected-title'}" StyleClasses="LabelSubText" />
                <ItemList Name="ExpectedList" MinHeight="140" HorizontalExpand="True" VerticalExpand="True" />
                <Button Name="DeleteErtButton" Text="{Loc 'ert-admin-delete-button'}" />
            </BoxContainer>
            <BoxContainer Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True" VerticalExpand="True">
                <Label Text="{Loc 'ert-admin-teams-title'}" StyleClasses="LabelSubText" />
                <ItemList Name="ResponceList" MinHeight="140" HorizontalExpand="True" VerticalExpand="True" />
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                <Label Text="{Loc 'ert-admin-arrival-label'}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <LineEdit Name="ArrivalSeconds" HorizontalExpand="True" />
                    <Button Name="SetArrivalButton" Text="{Loc 'ert-admin-apply-button'}" MinWidth="80" />
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="2">
                <Label Text="{Loc 'ert-admin-reason-label'}" StyleClasses="LabelSubText" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <LineEdit Name="ReasonEdit" HorizontalExpand="True" />
                    <Button Name="SetReasonButton" Text="{Loc 'ert-admin-set-reason-button'}" MinWidth="80" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="ReasonResponceEdit" HorizontalExpand="True" PlaceHolder="{Loc 'ert-admin-send-reason-label'}" />
            <Button Name="ResponceErtButton" Text="{Loc 'ert-admin-send-button'}" MinWidth="160" />
        </BoxContainer>
    </BoxContainer>
</DefaultWindow>
