<lobbyUi:LobbyGui
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:cc="clr-namespace:Content.Client.Administration.UI.CustomControls"
    xmlns:vote="clr-namespace:Content.Client.Voting.UI"
    xmlns:lobbyUi="clr-namespace:Content.Client.Lobby.UI"
    xmlns:info="clr-namespace:Content.Client.Info"
    xmlns:widgets="clr-namespace:Content.Client.UserInterface.Systems.Chat.Widgets"
    xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
    xmlns:changelog="clr-namespace:Content.Client.Changelog"
    xmlns:animatedBackground="clr-namespace:Content.Client._OS.UI.AnimatedBackground"
    xmlns:hull="clr-namespace:Content.Goobstation.UIKit.UserInterface.Lobby;assembly=Content.Goobstation.UIKit"
    xmlns:hullcontrols="clr-namespace:Content.Goobstation.UIKit.UserInterface.Controls;assembly=Content.Goobstation.UIKit">

    <!-- Анимированный фон -->
    <animatedBackground:AnimatedBackgroundControl
        Access="Public"
        VerticalExpand="True"
        HorizontalExpand="True"
        Name="Background"
        Stretch="KeepAspectCovered"/>

    <BoxContainer Name="MainContainer" VerticalExpand="True" HorizontalExpand="True" Orientation="Vertical" Margin="10 10 10 10" SeparationOverride="4">
        <!-- Mini Station top bar -->
        <controls:StripeBack>
            <PanelContainer Name="TopPanel" StyleClasses="LobbyBackground" HorizontalExpand="True" HorizontalAlignment="Stretch" VerticalAlignment="Top">
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True" HorizontalAlignment="Stretch" Margin="8 8 8 8" SeparationOverride="4">
                    <Button Name="Rules" Text="{Loc 'server-info-rules-button'}" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="Guidebook" Text="{Loc 'server-info-guidebook-button'}" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <changelog:ChangelogButton Name="Changelog" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <vote:VoteCallMenuButton Name="CallVoteButton" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <controls:VSpacer Spacing="25"/>
                    <TextureRect TextureScale="0.2 0.2" Stretch="KeepCentered" TexturePath="/Textures/Interface/main_logo.png" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <controls:VSpacer Spacing="25"/>
                    <Button Name="Site" Access="Public" Text="Сайт" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="Discord" Text="Дискорд" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="Telegram" Text="Телеграм" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Button Name="AuthorizationDiscordButton" StyleClasses="ButtonColorYellow" Access="Public" Text="Авторизация" MinSize="125 10" VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                    <Control HorizontalExpand="True"/>
                    <PanelContainer Name="ExpandPanel"
                                    StyleClasses="HullCard"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Visible="False">
                        <TextureButton Name="ExpandButton"
                                       TexturePath="filled_left_arrow.svg.192dpi"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       ModulateSelfOverride="#DEDEDE"
                                       Scale="0.5 0.5"
                                       Margin="4" />
                    </PanelContainer>
                </BoxContainer>
            </PanelContainer>
        </controls:StripeBack>

        <SplitContainer Name="SplitContainer" State="Auto" ResizeMode="NotResizable" HorizontalExpand="True" VerticalExpand="True">
            <BoxContainer Name="LeftSide" Orientation="Vertical" SeparationOverride="4" HorizontalExpand="True">
                <Control Name="DefaultState" VerticalExpand="True">
                    <BoxContainer Orientation="Vertical" SeparationOverride="4">
                        <PanelContainer StyleClasses="HullCard">
                            <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="4">
                                <lobbyUi:ServerListBox Name="ServerListBox" Access="Public" MinSize="0 0" VerticalExpand="False" HorizontalExpand="True" HorizontalAlignment="Stretch"/>
                                <info:ServerInfo Name="ServerInfo" Access="Public" MinSize="0 30" VerticalExpand="True" HorizontalExpand="True" HorizontalAlignment="Stretch"/>
                            </BoxContainer>
                        </PanelContainer>
                        <BoxContainer Orientation="Vertical" SeparationOverride="4" Name="VoteContainer"
                                      Access="Public" HorizontalAlignment="Left" VerticalAlignment="Top" />
                        <Control VerticalExpand="True" />
                        <BoxContainer Orientation="Vertical" HorizontalAlignment="Left" VerticalAlignment="Bottom"
                                      SeparationOverride="4" MaxWidth="520">
                            <PanelContainer Name="LobbyMessagePanel" StyleClasses="HullEdgePlate" Visible="False" Margin="0 0 0 4">
                                <RichTextLabel Name="LobbyMessageLabel" Access="Public" />
                            </PanelContainer>
                            <PanelContainer StyleClasses="HullEdgePlate" HorizontalAlignment="Left">
                                <RichTextLabel Name="LobbySong" Access="Public" />
                            </PanelContainer>
                            <PanelContainer StyleClasses="HullEdgePlate" HorizontalAlignment="Left">
                                <RichTextLabel Name="LobbyBackground" Access="Public" />
                            </PanelContainer>
                        </BoxContainer>
                    </BoxContainer>
                </Control>
                <Control Access="Public" Visible="False" Name="CharacterSetupState" VerticalExpand="True" />
            </BoxContainer>

            <hull:HullPanel Name="RightSide" Access="Public" HorizontalAlignment="Right" VerticalExpand="True"
                            VerticalAlignment="Stretch">
                <BoxContainer Orientation="Vertical" Margin="12 9 12 22" SeparationOverride="8">
                    <hull:HazardStripe MinHeight="6" Margin="13 0 13 7" />

                    <BoxContainer Name="HeaderContainer" Access="Public" Orientation="Horizontal" SeparationOverride="4">
                        <Label Name="ServerName" Access="Public" StyleClasses="HullHeading" VAlign="Center"
                               HorizontalExpand="True" ClipText="True" />
                        <Button Name="LinksButton" Text="{Loc 'ui-lobby-links-button'}" StyleClasses="HullPlate" />
                        <Button Name="AHelpButton" Access="Public" Text="{Loc 'ui-lobby-ahelp-button'}" StyleClasses="HullPlate" />
                        <Button Name="MenuButton" Text="{Loc 'ui-lobby-menu-button'}" StyleClasses="HullPlate" />
                        <TextureButton Name="CollapseButton"
                                       TexturePath="filled_right_arrow.svg.192dpi"
                                       VerticalAlignment="Center"
                                       ModulateSelfOverride="#DEDEDE"
                                       Scale="0.5 0.5" />
                    </BoxContainer>

                    <PanelContainer StyleClasses="HullCard">
                        <BoxContainer Orientation="Vertical" Margin="6">
                            <lobbyUi:LobbyCharacterPreviewPanel Name="CharacterPreview" Access="Public" />
                            <Label Name="Balance" Access="Public" StyleClasses="HullMuted" HorizontalAlignment="Right" />
                        </BoxContainer>
                    </PanelContainer>

                    <BoxContainer Orientation="Horizontal" SeparationOverride="3">
                        <Button Name="ChatTabButton" ToggleMode="True" StyleClasses="HullTab" HorizontalExpand="True"
                                Text="{Loc 'ui-lobby-chat-tab'}" />
                        <ContainerButton Name="NewsTabButton" ToggleMode="True" StyleClasses="HullTab" HorizontalExpand="True">
                            <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" SeparationOverride="6">
                                <Label Text="{Loc 'ui-lobby-news-tab'}" />
                                <hull:IndicatorLamp Name="NewsLamp" Visible="False" Margin="0 2 0 0" />
                            </BoxContainer>
                        </ContainerButton>
                    </BoxContainer>

                    <PanelContainer StyleClasses="HullInset" VerticalExpand="True">
                        <Control Margin="4" VerticalExpand="True">
                            <Control Name="NewsContainer" Access="Public" VerticalExpand="True" />
                            <widgets:ChatBox Name="Chat" Access="Public" VerticalExpand="True" MinHeight="50" Visible="False" />
                        </Control>
                    </PanelContainer>

                    <PanelContainer StyleClasses="HullRoundPanel">
                        <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="8">
                            <BoxContainer Orientation="Horizontal" SeparationOverride="10">
                                <BoxContainer Orientation="Vertical" HorizontalExpand="True" SeparationOverride="4">
                                    <PanelContainer StyleClasses="HullLcd" HorizontalExpand="True" VerticalExpand="True" Margin="0 0 0 4">
                                        <BoxContainer Orientation="Vertical" VerticalAlignment="Center">
                                            <Label Name="StartTimeCaption" StyleClasses="HullLcdCaption" HorizontalAlignment="Center" />
                                            <hullcontrols:SevenSegmentDisplay Name="StartTime" Access="Public" MinDigits="4" HorizontalAlignment="Center" Margin="0 2 0 0" />
                                        </BoxContainer>
                                    </PanelContainer>
                                    <PanelContainer StyleClasses="HullFact" HorizontalExpand="True">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                            <Label Text="{Loc 'ui-lobby-fact-map'}" StyleClasses="HullFactKey" />
                                            <Label Name="MapValue" Access="Public" Text="-" StyleClasses="HullFactValue" HorizontalExpand="True" ClipText="True" />
                                        </BoxContainer>
                                    </PanelContainer>
                                    <PanelContainer StyleClasses="HullFact" HorizontalExpand="True">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                            <Label Text="{Loc 'ui-lobby-fact-mode'}" StyleClasses="HullFactKey" />
                                            <Label Name="ModeValue" Access="Public" Text="-" StyleClasses="HullFactValue" HorizontalExpand="True" ClipText="True" />
                                        </BoxContainer>
                                    </PanelContainer>
                                    <PanelContainer StyleClasses="HullFact" HorizontalExpand="True">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                            <Label Text="{Loc 'ui-lobby-fact-round'}" StyleClasses="HullFactKey" />
                                            <Label Name="RoundValue" Access="Public" Text="-" StyleClasses="HullFactValue" HorizontalExpand="True" ClipText="True" />
                                        </BoxContainer>
                                    </PanelContainer>
                                    <PanelContainer StyleClasses="HullFact" HorizontalExpand="True">
                                        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
                                            <Label Text="{Loc 'ui-lobby-fact-ready'}" StyleClasses="HullFactKey" />
                                            <Label Name="ReadyValue" Access="Public" Text="-" StyleClasses="HullFactValue" HorizontalExpand="True" ClipText="True" />
                                        </BoxContainer>
                                    </PanelContainer>
                                </BoxContainer>
                                <BoxContainer Orientation="Vertical" SeparationOverride="6">
                                    <hull:HazardStripe HorizontalAlignment="Center">
                                        <Button Name="ReadyButton" Access="Public" ToggleMode="True"
                                                Text="{Loc 'ui-lobby-ready-up-button'}"
                                                StyleClasses="HullReadyArt" SetSize="128 64" Margin="4" />
                                    </hull:HazardStripe>
                                    <cc:UICommandButton Command="observe" Name="ObserveButton" Access="Public"
                                                        Text="{Loc 'ui-lobby-observe-button'}"
                                                        StyleClasses="HullPlate" HorizontalAlignment="Center" MinWidth="100"
                                                        WindowType="{x:Type lobbyUi:ObserveWarningWindow}" />
                                    <Button Name="ManifestButton" Access="Public"
                                            Text="{Loc 'ui-lobby-manifest-button'}"
                                            StyleClasses="HullPlate" HorizontalAlignment="Center" MinWidth="100" />
                                    <Button Name="CharacterSetup" Access="Public"
                                            Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                                            StyleClasses="HullPlate" HorizontalAlignment="Center" MinWidth="100" />
                                    <TextureRect TexturePath="/Textures/_Goobstation/Interface/Lobby/metal_panel.png"
                                                 Stretch="KeepCentered" HorizontalAlignment="Center" Margin="0 2 0 0" />
                                </BoxContainer>
                            </BoxContainer>

                            <!-- Временно забаненным вместо персонализации показываем остаток срока -->
                            <controls:StripeBack Name="BanTimePanel" Access="Public" Visible="False" MinSize="250 48" MaxSize="280 48" ToolTip="{Loc 'katorga-ban-lobby-tooltip'}">
                                <Label Name="BanTimeLabel" Access="Public" Align="Center" VerticalAlignment="Center" HorizontalAlignment="Center" FontColorOverride="{x:Static controls:StyleNano.ButtonColorCautionDefault}"/>
                            </controls:StripeBack>

                            <RichTextLabel Name="PlaytimeComment" Visible="False" Access="Public" HorizontalAlignment="Center" />
                        </BoxContainer>
                    </PanelContainer>
                </BoxContainer>
            </hull:HullPanel>
        </SplitContainer>
    </BoxContainer>
</lobbyUi:LobbyGui>
