<!-- Goob -->
<Control
    xmlns="https://spacestation14.io"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <BoxContainer Name="VBox" Orientation="Vertical">
        <BoxContainer Name="Loaded" Orientation="Horizontal" SeparationOverride="8" Visible="False">
            <BoxContainer Name="ViewBox" Orientation="Horizontal" VerticalAlignment="Center" />
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Center" SeparationOverride="4">
                <Label Text="{Loc 'lobby-character-preview-panel-header'}" StyleClasses="HullMuted" />
                <Label Name="Summary" StyleClasses="HullPostTitle" ClipText="True" />
                <BoxContainer Orientation="Horizontal" SeparationOverride="4">
                    <Button Name="CharacterSetup" Access="Public"
                            Text="{Loc 'lobby-character-preview-panel-character-setup-button'}"
                            StyleClasses="HullPlate" />
                </BoxContainer>
            </BoxContainer>
        </BoxContainer>
        <Label Name="Unloaded" Text="{Loc 'lobby-character-preview-panel-unloaded-preferences-label'}" />
    </BoxContainer>
</Control>
