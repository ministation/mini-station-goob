<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls"
                      x:Class="Content.Client._Mini.DecaCode.UI.DecaCodeLockWindow"
                      Title="{Loc 'deca-code-lock-window-title'}"
                      MinSize="380 280"
                      SetSize="440 400">
    <BoxContainer Orientation="Vertical" Margin="8" SeparationOverride="8">
        <PanelContainer Name="BombWarningPanel">
            <RichTextLabel Name="BombWarningLabel" Margin="8 6" />
        </PanelContainer>

        <BoxContainer Orientation="Horizontal" SeparationOverride="6">
            <LineEdit Name="CodeLineEdit"
                      HorizontalExpand="True"
                      PlaceHolder="{Loc 'deca-code-lock-placeholder'}" />
            <Button Name="SubmitButton"
                    Text="{Loc 'deca-code-lock-submit'}"
                    MinWidth="90" />
        </BoxContainer>

        <PanelContainer StyleClasses="LowDivider" />

        <ScrollContainer HorizontalExpand="True" VerticalExpand="True">
            <GridContainer Name="AttemptsGrid"
                           Columns="3"
                           HSeparationOverride="16"
                           VSeparationOverride="3" />
        </ScrollContainer>
    </BoxContainer>
</controls:FancyWindow>
