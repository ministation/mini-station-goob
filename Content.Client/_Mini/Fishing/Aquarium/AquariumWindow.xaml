<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                      xmlns:aquarium="clr-namespace:Content.Client._Mini.Fishing.Aquarium"
                      Title="{Loc 'aquarium-window-title'}"
                      SetSize="700 620"
                      MinSize="600 480">
    <BoxContainer Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True" Margin="8">
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 6 0">
                <Label Text="{Loc 'aquarium-window-fluid'}"/>
                <OptionButton Name="FluidSelector"/>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True" Margin="0 0 6 0">
                <Label Text="{Loc 'aquarium-window-temperature'}"/>
                <BoxContainer Orientation="Horizontal" HorizontalExpand="True">
                    <SpinBox Name="TemperatureSpin" HorizontalExpand="True"/>
                    <Label Name="TemperatureLabel" Margin="6 0 0 0"/>
                </BoxContainer>
            </BoxContainer>
            <BoxContainer Orientation="Vertical" HorizontalExpand="True">
                <Label Text="{Loc 'aquarium-window-mode'}"/>
                <OptionButton Name="ModeSelector"/>
            </BoxContainer>
        </BoxContainer>
        <BoxContainer Orientation="Horizontal" HorizontalExpand="True" Margin="0 6 0 0">
            <Label Name="BeautyLabel" VerticalAlignment="Center"/>
            <Control HorizontalExpand="True"/>
            <Label Name="CountLabel" VerticalAlignment="Center" Margin="0 0 6 0"/>
            <Button Name="FeedButton" Text="{Loc 'aquarium-window-feed'}"/>
        </BoxContainer>
        <Label Name="BrokenLabel" Visible="False" Margin="0 4 0 0"/>
        <PanelContainer MinHeight="150" HorizontalExpand="True" Margin="0 6 0 0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#101018"/>
            </PanelContainer.PanelOverride>
            <aquarium:AquariumTankControl Name="Tank" HorizontalExpand="True" VerticalExpand="True" Margin="2"/>
        </PanelContainer>
        <Label Text="{Loc 'aquarium-window-fish'}" Margin="0 8 0 2"/>
        <PanelContainer VerticalExpand="True" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
            </PanelContainer.PanelOverride>
            <ScrollContainer VerticalExpand="True" HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="FishList" Orientation="Vertical" VerticalExpand="True" HorizontalExpand="True"/>
            </ScrollContainer>
        </PanelContainer>
        <Label Text="{Loc 'aquarium-window-props'}" Margin="0 8 0 2"/>
        <PanelContainer MinHeight="90" HorizontalExpand="True">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#1B1B1E"/>
            </PanelContainer.PanelOverride>
            <ScrollContainer HorizontalExpand="True" HScrollEnabled="False">
                <BoxContainer Name="PropList" Orientation="Vertical" HorizontalExpand="True"/>
            </ScrollContainer>
        </PanelContainer>
    </BoxContainer>
</controls:FancyWindow>
