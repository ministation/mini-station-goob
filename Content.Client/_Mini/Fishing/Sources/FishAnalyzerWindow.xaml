<controls:FancyWindow xmlns="https://spacestation14.io"
                      xmlns:controls="clr-namespace:Content.Client.UserInterface.Controls;assembly=Content.Client"
                      Title="{Loc 'fishing-analyzer-title'}"
                      SetSize="450 540"
                      MinSize="360 320">
  <BoxContainer Orientation="Vertical" Margin="6" SeparationOverride="6">
    <Label Name="EmptyLabel"
           Text="{Loc 'fishing-analyzer-no-data'}"
           StyleClasses="LabelSubText"
           HorizontalAlignment="Center"
           Margin="0 16"
           Visible="False"/>
    <ScrollContainer Name="Scroll" HorizontalExpand="True" VerticalExpand="True" HScrollEnabled="False">
      <BoxContainer Name="Cards" Orientation="Vertical" HorizontalExpand="True" SeparationOverride="8"/>
    </ScrollContainer>
  </BoxContainer>
</controls:FancyWindow>
