<PanelContainer xmlns="https://spacestation14.io"
                xmlns:gfx="clr-namespace:Robust.Client.Graphics;assembly=Robust.Client"
                Margin="0,0,0,6"
                HorizontalExpand="True">
    <PanelContainer.PanelOverride>
        <gfx:StyleBoxFlat
            BackgroundColor="#151A24"
            BorderColor="#2A3344"
            BorderThickness="1"
            ContentMarginLeftOverride="0"
            ContentMarginRightOverride="10"
            ContentMarginTopOverride="8"
            ContentMarginBottomOverride="8" />
    </PanelContainer.PanelOverride>
    <BoxContainer Orientation="Horizontal" HorizontalExpand="True" SeparationOverride="0">
        <PanelContainer Name="AccentRail" MinWidth="5" MaxWidth="5" SetWidth="5" VerticalExpand="True" Margin="0,0,10,0">
            <PanelContainer.PanelOverride>
                <gfx:StyleBoxFlat BackgroundColor="#C23B3B" />
            </PanelContainer.PanelOverride>
        </PanelContainer>

        <!-- Icon + buy button stacked, same 56px width -->
        <BoxContainer Orientation="Vertical"
                      VerticalAlignment="Top"
                      HorizontalExpand="False"
                      MinWidth="56"
                      MaxWidth="56"
                      SetWidth="56"
                      Margin="0,0,10,0"
                      SeparationOverride="6">
            <PanelContainer MinSize="56 56" MaxSize="56 56" SetSize="56 56">
                <PanelContainer.PanelOverride>
                    <gfx:StyleBoxFlat
                        BackgroundColor="#0D1118"
                        BorderColor="#2A3344"
                        BorderThickness="1"
                        ContentMarginLeftOverride="4"
                        ContentMarginRightOverride="4"
                        ContentMarginTopOverride="4"
                        ContentMarginBottomOverride="4" />
                </PanelContainer.PanelOverride>
                <EntityPrototypeView
                    Name="StoreItemEntity"
                    MinSize="48 48"
                    Stretch="Fit"
                    Visible="False" />
                <TextureRect
                    Name="StoreItemTexture"
                    MinSize="48 48"
                    Stretch="KeepAspectCentered"
                    Visible="False" />
            </PanelContainer>

            <Button
                Name="StoreItemBuyButton"
                MinSize="56 28"
                MaxSize="56 28"
                SetSize="56 28"
                RectClipContent="False"
                Access="Public">
                <BoxContainer Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center" SeparationOverride="2">
                    <Label Name="BuyPriceLabel" Align="Center" VAlign="Center" />
                    <!-- Layout slot stays small so the button size doesn't grow; KeepCentered + TextureScale draws larger and overflows. -->
                    <TextureRect
                        Name="CurrencyIcon"
                        MinSize="14 14"
                        MaxSize="14 14"
                        SetSize="14 14"
                        CanShrink="True"
                        Stretch="KeepCentered"
                        TextureScale="1 1"
                        Visible="False" />
                </BoxContainer>
            </Button>
        </BoxContainer>

        <BoxContainer Name="TextColumn" Orientation="Vertical" HorizontalExpand="True" VerticalAlignment="Top">
            <Label Name="StoreItemName" StyleClasses="LabelHeading" HorizontalExpand="True" ClipText="True" />
            <RichTextLabel Name="StoreItemDescription" HorizontalExpand="True" />
            <Label Name="DiscountSubText" StyleClasses="LabelSubText" Visible="False" />
        </BoxContainer>
    </BoxContainer>
</PanelContainer>
